{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moodle-blockly-scorm/activity-config.schema.json",
  "title": "Activity Configuration",
  "description": "Configuration for a Blockly-SCORM activity in Moodle",
  "type": "object",
  "required": ["metadata", "blockly_setup", "evaluation"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["activity_id", "title"],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Unique identifier for the activity (lowercase, underscores, no spaces)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Display title shown to students"
        },
        "version": {
          "type": "string",
          "default": "1.0",
          "description": "Config version for migration support"
        },
        "description": {
          "type": "string",
          "description": "Brief description of the activity"
        }
      }
    },
    "instructions": {
      "type": "object",
      "properties": {
        "main": {
          "type": "string",
          "description": "Primary instruction text shown to students"
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered step-by-step guidance"
        }
      }
    },
    "ui_settings": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["default", "dark", "high_contrast"],
          "default": "default"
        },
        "show_code_toggle": {
          "type": "boolean",
          "default": false,
          "description": "Allow students to see generated JavaScript"
        },
        "show_hint_panel": {
          "type": "boolean",
          "default": true,
          "description": "Enable student-facing hints in the UI"
        },
        "max_attempts": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null,
          "description": "Maximum submission attempts (null = unlimited)"
        }
      }
    },
    "blockly_setup": {
      "type": "object",
      "required": ["toolbox"],
      "properties": {
        "toolbox": {
          "type": "object",
          "required": ["categories"],
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "blocks"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Category display name"
                  },
                  "colour": {
                    "type": "string",
                    "description": "Category colour (hex or hue number)"
                  },
                  "blocks": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of Blockly block type identifiers"
                  }
                }
              }
            }
          }
        },
        "starting_blocks": {
          "description": "Blockly workspace state in JSON serialization format (null = empty workspace)",
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ],
          "default": null
        },
        "max_blocks": {
          "type": ["integer", "null"],
          "minimum": 1,
          "default": null,
          "description": "Maximum number of blocks allowed (null = unlimited)"
        },
        "disabled_blocks": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Block types that appear greyed out and cannot be used"
        }
      }
    },
    "hints": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/hint"
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["test_cases"],
      "properties": {
        "grading_mode": {
          "type": "string",
          "enum": ["pass_fail", "weighted"],
          "default": "weighted",
          "description": "pass_fail: 100 or 0; weighted: sum of passing test points"
        },
        "max_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "feedback_on_all_pass": {
          "type": "string",
          "description": "Optional subtitle shown in the results header when every automated test passes"
        },
        "require_previous_test_pass": {
          "type": "boolean",
          "default": true,
          "description": "If true, tests run in order and later tests are skipped until earlier tests pass"
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/test_case"
          }
        }
      }
    }
  },
  "definitions": {
    "condition": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "block_exists" },
            "block_type": { "type": "string" },
            "min_count": { "type": "integer", "minimum": 1, "default": 1 }
          },
          "required": ["type", "block_type"]
        },
        {
          "properties": {
            "type": { "const": "block_missing" },
            "block_type": { "type": "string" }
          },
          "required": ["type", "block_type"]
        },
        {
          "properties": {
            "type": { "const": "block_connected" },
            "upper_type": { "type": "string" },
            "lower_type": { "type": "string" }
          },
          "required": ["type", "upper_type", "lower_type"]
        },
        {
          "properties": {
            "type": { "const": "block_nested" },
            "outer_type": { "type": "string" },
            "inner_type": { "type": "string" },
            "input_name": { "type": "string" },
            "field_name": { "type": "string" },
            "expected_value": {},
            "match_mode": {
              "type": "string",
              "enum": ["exact", "contains", "regex", "regex_full", "regex_search"],
              "default": "exact"
            },
            "case_sensitive": { "type": "boolean", "default": true },
            "regex_flags": { "type": "string", "default": "" }
          },
          "required": ["type", "outer_type", "inner_type", "input_name"]
        },
        {
          "properties": {
            "type": { "const": "block_pattern" },
            "workspace_state": { "type": "object" },
            "field_constraints": { "type": "object", "default": {} }
          },
          "required": ["type", "workspace_state"]
        },
        {
          "properties": {
            "type": { "const": "block_field_value" },
            "block_type": { "type": "string" },
            "field_name": { "type": "string" },
            "expected_value": {},
            "match_mode": {
              "type": "string",
              "enum": ["exact", "contains", "regex", "regex_full", "regex_search"],
              "default": "exact"
            },
            "case_sensitive": { "type": "boolean", "default": true },
            "regex_flags": { "type": "string", "default": "" }
          },
          "required": ["type", "block_type", "field_name", "expected_value"]
        },
        {
          "properties": {
            "type": { "const": "block_count" },
            "block_type": { "type": "string" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "block_type"]
        },
        {
          "properties": {
            "type": { "const": "workspace_connectedness" },
            "mode": {
              "type": "string",
              "enum": ["all_connected", "all_active"],
              "default": "all_connected"
            }
          },
          "required": ["type", "mode"]
        },
        {
          "properties": {
            "type": { "const": "workspace_empty" }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "all" },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/definitions/condition" },
              "minItems": 1
            }
          },
          "required": ["type", "conditions"]
        },
        {
          "properties": {
            "type": { "const": "any" },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/definitions/condition" },
              "minItems": 1
            }
          },
          "required": ["type", "conditions"]
        },
        {
          "properties": {
            "type": { "const": "none" },
            "conditions": {
              "type": "array",
              "items": { "$ref": "#/definitions/condition" },
              "minItems": 1
            }
          },
          "required": ["type", "conditions"]
        }
      ]
    },
    "hint": {
      "type": "object",
      "required": ["id", "trigger", "message"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique hint identifier"
        },
        "trigger": {
          "type": "object",
          "required": ["event"],
          "properties": {
            "event": {
              "type": "string",
              "enum": ["workspace_change", "test_fail", "manual", "timed"]
            },
            "conditions": {
              "$ref": "#/definitions/condition",
              "description": "Workspace conditions (required for workspace_change event)"
            },
            "after_attempts": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Only trigger after this many failed test runs"
            }
          }
        },
        "message": {
          "type": "string",
          "description": "Hint text shown to the student"
        },
        "display_mode": {
          "type": "string",
          "enum": ["triggered", "checklist"],
          "default": "triggered",
          "description": "triggered: hide this hint until it fires; checklist: always show it in the sidebar and tick it off when triggered"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Higher priority hints suppress lower ones"
        },
        "delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Delay before showing after trigger condition is met"
        },
        "show_once": {
          "type": "boolean",
          "default": false,
          "description": "If true, don't re-show after student dismisses"
        }
      }
    },
    "runtime_text_assertion": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this assertion is checked or ignored"
        },
        "expected": {
          "type": "string",
          "description": "Expected prompt text or stdout transcript"
        },
        "match_mode": {
          "type": "string",
          "enum": ["exact", "contains", "regex"],
          "default": "exact"
        },
        "match_any_item": {
          "type": "boolean",
          "default": false,
          "description": "When true, compare against any individual captured item instead of the combined transcript"
        },
        "show_expected": {
          "type": "boolean",
          "default": false,
          "description": "Show the expected value to the student when this assertion fails"
        },
        "show_actual": {
          "type": "boolean",
          "default": false,
          "description": "Show the actual captured value to the student when this assertion fails"
        },
        "success_message": {
          "type": "string",
          "description": "Optional student-facing success message for this assertion"
        },
        "failure_message": {
          "type": "string",
          "description": "Optional student-facing failure message for this assertion"
        }
      }
    },
    "variable_list_index_check": {
      "type": "object",
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "expected_value": {},
        "expected_type": {
          "type": "string",
          "enum": ["any", "int", "float", "string", "list"],
          "default": "any"
        }
      },
      "required": ["index"]
    },
    "variable_list_assertions": {
      "type": "object",
      "properties": {
        "length_enabled": { "type": "boolean", "default": false },
        "length_value": { "type": "integer", "minimum": 0, "default": 0 },
        "length_comparison": {
          "type": "string",
          "enum": ["equals", "gt", "lt", "gte", "lte"],
          "default": "equals"
        },
        "values_enabled": { "type": "boolean", "default": false },
        "values_match_mode": {
          "type": "string",
          "enum": [
            "exact_order",
            "same_values_any_order",
            "expected_subset_of_actual",
            "expected_superset_of_actual"
          ],
          "default": "exact_order"
        },
        "expected_values": {
          "type": "array",
          "default": []
        },
        "item_types_enabled": { "type": "boolean", "default": false },
        "item_type_mode": {
          "type": "string",
          "enum": ["all", "some", "none"],
          "default": "all"
        },
        "expected_item_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["int", "float", "string", "list"]
          },
          "default": []
        },
        "index_checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/variable_list_index_check" },
          "default": []
        }
      }
    },
    "test_case": {
      "type": "object",
      "required": ["id", "type"],
      "anyOf": [
        { "required": ["points"] },
        { "required": ["weight"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "points": {
          "type": "integer",
          "minimum": 0,
          "description": "Integer points awarded when the test passes"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "description": "Legacy alias for points"
        },
        "feedback_on_pass": { "type": "string" },
        "feedback_on_fail": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "stdout_match" },
            "prompt_inputs": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "strict_prompt_inputs": {
              "type": "boolean",
              "default": true,
              "description": "If true, extra or missing prompt() calls fail the test"
            },
            "output_assertion": {
              "$ref": "#/definitions/runtime_text_assertion"
            },
            "prompt_assertion": {
              "$ref": "#/definitions/runtime_text_assertion"
            },
            "expected_output": {
              "type": "string",
              "description": "Legacy alias for output_assertion.expected"
            },
            "match_mode": {
              "type": "string",
              "enum": ["exact", "contains", "regex"],
              "default": "exact",
              "description": "Legacy alias for output_assertion.match_mode"
            }
          },
          "required": ["type"]
        },
        {
          "properties": {
            "type": { "const": "block_structure" },
            "conditions": { "$ref": "#/definitions/condition" }
          },
          "required": ["type", "conditions"]
        },
        {
          "properties": {
            "type": { "const": "variable_state" },
            "prompt_inputs": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "strict_prompt_inputs": {
              "type": "boolean",
              "default": true
            },
            "variable_name": { "type": "string" },
            "expected_type": {
              "type": "string",
              "enum": ["any", "int", "float", "string", "list"],
              "default": "any"
            },
            "value_assertion_enabled": {
              "type": "boolean",
              "default": true
            },
            "expected_value": {},
            "comparison": {
              "type": "string",
              "enum": ["equals", "gt", "lt", "gte", "lte", "contains", "type"],
              "default": "equals"
            },
            "show_coerced_value_hint": {
              "type": "boolean",
              "default": false
            },
            "list_assertions": {
              "$ref": "#/definitions/variable_list_assertions"
            }
          },
          "required": ["type", "variable_name"]
        }
      ]
    }
  }
}
